# Product fragment for the rabbit r1 vendor blobs.
# Inherited by device/rabbit/r1/device.mk once blobs are present.

LOCAL_PATH := $(call my-dir)

# Copy the proprietary blobs into the vendor image. The actual mapping is
# generated by setup-makefiles.sh into Android.mk; include it here so the
# blobs land in the right partition.
include $(LOCAL_PATH)/Android.mk