<!--
  Framework overlay for the rabbit r1's small (~2.88") portrait screen.

  Values are PLACEHOLDERS pending measurement of the real display
  (resolution and density via `adb shell wm size` / `wm density`).
  See docs/hardware.md and PLAN.md §7.
-->
<resources>
    <!-- Portrait, single-column: no multi-window or desktop-style UI. -->
    <bool name="config_supportsMultiWindow">false</bool>

    <!-- Large touch targets on a small screen. -->
    <dimen name="config_minScalingSpan">320dp</dimen>

    <!-- Disable the navigation bar; the r1 has hardware controls. -->
    <bool name="config_showNavigationBar">false</bool>
</resources>